# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# assets: QA run artifacts + design handoffs live outside the repo.
# (Brand kit is versioned separately in /public/brand.)
/assets/

# typescript
*.tsbuildinfo
next-env.d.ts

# Config local de Claude Code: guarda allowlists de permisos que pueden llevar
# tokens literales. Hoy sólo lo protege el gitignore GLOBAL del equipo, que no
# existe en otra máquina — este repo es público, así que se ignora aquí también.
.claude/settings.local.json

# Salida de scripts/rotate-test-passwords.mjs — contraseñas en claro, se borra a mano
.secrets-rotacion.txt
