# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Database
# PostgreSQL connection string (used for server-side operations)
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# Authentication
# JWT secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Maps (Optional - for future map integration)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# IA — agentes de informe y cumplido (app/api/informe, app/api/cumplidos)
# Se prueban en orden: si ANTHROPIC_API_KEY está, se usa Claude; si no, y
# GEMINI_API_KEY sí está, se usa Gemini (tier gratis, sin tarjeta, en
# https://aistudio.google.com/apikey) como respaldo mientras se resuelve el
# pago en la consola de Anthropic. Ver lib/ia/informe.ts.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Email (Optional - for notifications)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@despachr.app

# Environment
NODE_ENV=development
